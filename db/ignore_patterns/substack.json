        "^https?://({primary_netloc}|[^/]*\\.substack\\.com)/.*/g_auto/https%3A%2F%2Fsubstack\\.com%2Fimg%2Favatars%2Flogged-out\\.png",
        "^https?://({primary_netloc}|[^/]*\\.substack\\.com)/.*/https%3A%2F%2F[^%]+\\.s3\\.amazonaws\\.com%2Fpublic%2Fimages%2F",
